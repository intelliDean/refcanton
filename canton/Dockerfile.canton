# canton/Dockerfile.canton
# Production-ready Canton 3.4.11 Multi-Participant Cluster Image

FROM eclipse-temurin:21-jre-alpine

RUN apk add --no-cache bash curl libc6-compat

WORKDIR /canton

RUN mkdir -p /canton/bin /canton/dars /canton/log

# Copy configuration and bootstrap scripts
COPY canton.conf /canton/canton.conf
COPY bootstrap.canton /canton/bootstrap.canton
COPY entrypoint.sh /canton/entrypoint.sh
RUN chmod +x /canton/entrypoint.sh

# Copy binaries from build context (or download dynamically if missing)
ARG CANTON_VERSION=3.4.11
COPY bin/ /canton/bin/
RUN if [ ! -f /canton/bin/canton.jar ]; then \
      echo "Downloading Canton ${CANTON_VERSION} from GitHub releases..." && \
      curl -L -f "https://github.com/digital-asset/daml/releases/download/v${CANTON_VERSION}/canton-open-source-${CANTON_VERSION}.tar.gz" -o /tmp/canton.tar.gz && \
      tar -xzf /tmp/canton.tar.gz -C /tmp && \
      cp /tmp/canton-open-source-${CANTON_VERSION}/lib/canton.jar /canton/bin/canton.jar && \
      rm -rf /tmp/canton*; \
    fi

# Copy DAR artifacts
COPY dars/ /canton/dars/

# Expose Sequencer / Mediator ports
EXPOSE 5001 5002 5003

# Expose Participant Ledger API ports
# Participant 1 (Alice / Borrower)
EXPOSE 5011 5012 5014
# Participant 2 (LegacyBank / Lender A)
EXPOSE 5021 5022 5024
# Participant 3 (NeoCapital / Lender B)
EXPOSE 5031 5032 5034

ENV JAVA_OPTS="-Xms512m -Xmx2048m"

ENTRYPOINT ["/canton/entrypoint.sh"]
