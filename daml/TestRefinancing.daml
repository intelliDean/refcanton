-- TestRefinancing.daml
-- Ref Canton: Private Refinancing App
-- Comprehensive automated test script verifying:
-- 1. Happy path: Atomic closing (101,000 payoff, 100k new loan, 1k contribution, 150 collateral units moved)
-- 2. Before/after ledger balances & loan states
-- 3. Failure cases: insufficient borrower funds, replay attempts, expired approvals
-- 4. Regression tests:
--    - Payment-free release through the quote (must fail)
--    - Correct asset name with wrong issuer (must fail)
--    - Excess funding (must return change to Lender B)
--    - Collateral reuse with fresh offers (must fail)
-- 5. Privacy verification: Role-isolated receipts, separate lender visibility checks

module TestRefinancing where

import Daml.Script
import DA.Date (date, Month(..))
import DA.Time (time)
import Assets
import Loan
import Approvals
import Closing
import Setup (TestParties(..), InitialLedgerState(..), initializeLedger, initializeLedgerWithBorrowerCash)

-- ─────────────────────────────────────────────────────────────────────────────
-- TEST FIXTURE HELPERS
-- ─────────────────────────────────────────────────────────────────────────────

data TestApprovals = TestApprovals
  with
    payoffQuoteCid          : ContractId PayoffQuote
    replacementOfferCid     : ContractId ReplacementOffer
    allocatedLenderBCashCid : ContractId CashHolding
  deriving (Eq, Show)

-- Helper to set up active binding PayoffQuote and ReplacementOffer
setupApprovals : TestParties -> InitialLedgerState -> Time -> Script TestApprovals
setupApprovals parties state tExpiry = do
  let TestParties{operator, borrower, lenderA, lenderB} = parties
  let InitialLedgerState{loanACid, lenderBCashCid} = state

  -- LenderA issues PayoffQuote for 101,000 USD-TEST
  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA
      borrower
      expectedOperator  = operator
      expectedRecipient = lenderA
      expectedLocker    = lenderB
      loanACid
      payoffAmount      = 101000.0
      instrument        = "USD-TEST"
      expiresAt         = tExpiry

  -- LenderB prepares funding allocation for borrower
  allocatedLenderBCashCid <- submit lenderB do
    exerciseCmd lenderBCashCid Allocate with
      forParty = borrower

  -- LenderB issues ReplacementOffer for 100,000 USD-TEST (with private capRate 7.5%)
  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB
      borrower
      operator
      expectedRecipient    = lenderA
      newPrincipal         = 100000.0
      maturityDate         = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = allocatedLenderBCashCid
      cashInstrument       = "USD-TEST"
      expiresAt            = tExpiry
      capRate              = 0.075
      amortizationPeriods  = 24

  return TestApprovals with
    payoffQuoteCid
    replacementOfferCid
    allocatedLenderBCashCid


-- ─────────────────────────────────────────────────────────────────────────────
-- 1. HAPPY PATH: Full Refinancing Lifecycle
-- ─────────────────────────────────────────────────────────────────────────────

testRefinancingLifecycle : Script ()
testRefinancingLifecycle = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  -- 1. INITIAL STATE SETUP
  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  -- Verify initial state
  Some loanA <- queryContractId borrower state.loanACid
  assert (loanA.principal == 101000.0)
  assert (loanA.lenderA == lenderA)

  -- 2. BINDING APPROVALS
  approvals <- setupApprovals state.parties state tExpiry

  -- 3. CLOSING INITIATION & ATOMIC EXECUTION
  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Execute atomic closing
  (receiptA, receiptB, receiptBorrower) <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- 4. VERIFY FINAL LEDGER STATE
  -- A. LoanA must be archived
  loanAAfter <- queryContractId borrower state.loanACid
  assert (loanAAfter == None)

  -- B. LoanB must exist with 100,000 principal
  Some rcBorrower <- queryContractId borrower receiptBorrower
  let newLoanBCid = rcBorrower.loanBCid

  Some loanB <- queryContractId borrower newLoanBCid
  assert (loanB.principal == 100000.0)
  assert (loanB.lenderB == lenderB)
  assert (loanB.borrower == borrower)

  -- C. Collateral must now be locked to LenderB (150 units)
  Some newCollateral <- queryContractId borrower loanB.collateralCid
  assert (newCollateral.locker == lenderB)
  assert (newCollateral.amount == 150.0)
  assert (newCollateral.owner == borrower)

  -- D. LenderA received 101,000 USD-TEST in total (100,000 from B + 1,000 from borrower)
  lenderAHoldings <- queryFilter @CashHolding lenderA (\h -> h.owner == lenderA)
  let totalLenderACash = sum (map (\(_, h) -> h.amount) lenderAHoldings)
  assert (totalLenderACash == 101000.0)

  -- E. Borrower spent 1,000 and has 4,000 remaining
  borrowerHoldings <- queryFilter @CashHolding borrower (\h -> h.owner == borrower)
  let totalBorrowerCash = sum (map (\(_, h) -> h.amount) borrowerHoldings)
  assert (totalBorrowerCash == 4000.0)

  -- 5. ROLE-ISOLATED RECEIPTS VERIFICATION
  -- Lender A sees receiptA
  Some rA <- queryContractId lenderA receiptA
  assert (rA.payoffAmount == 101000.0)
  assert (rA.lenderA == lenderA)

  -- Lender B sees receiptB
  Some rB <- queryContractId lenderB receiptB
  assert (rB.principalFunded == 100000.0)
  assert (rB.lenderB == lenderB)

  -- Lender A CANNOT see receiptB or receiptBorrower
  rBFromA <- queryContractId lenderA receiptB
  assertMsg "Privacy breach: LenderA sees receiptB" (rBFromA == None)

  rBorrowerFromA <- queryContractId lenderA receiptBorrower
  assertMsg "Privacy breach: LenderA sees receiptBorrower" (rBorrowerFromA == None)

  -- Lender B CANNOT see receiptA or receiptBorrower
  rAFromB <- queryContractId lenderB receiptA
  assertMsg "Privacy breach: LenderB sees receiptA" (rAFromB == None)

  rBorrowerFromB <- queryContractId lenderB receiptBorrower
  assertMsg "Privacy breach: LenderB sees receiptBorrower" (rBorrowerFromB == None)

  return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- 2. REGRESSION TESTS
-- ─────────────────────────────────────────────────────────────────────────────

-- 2.1: Payment-free release through the quote MUST FAIL
-- Tests that borrower cannot exercise SettleAndRepledge without valid payment cash
testPaymentFreeReleaseFails : Script ()
testPaymentFreeReleaseFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA
      borrower
      expectedOperator  = operator
      expectedRecipient = lenderA
      expectedLocker    = lenderB
      loanACid          = state.loanACid
      payoffAmount      = 101000.0
      instrument        = "USD-TEST"
      expiresAt         = tExpiry

  -- Attempt 1: Empty payment cash list
  submitMustFail borrower do
    exerciseCmd payoffQuoteCid SettleAndRepledge with
      newLocker       = lenderB
      collateralCid   = state.collateralCid
      paymentCashCids = []

  -- Attempt 2: Payment cash owned by borrower instead of lenderA
  submitMustFail borrower do
    exerciseCmd payoffQuoteCid SettleAndRepledge with
      newLocker       = lenderB
      collateralCid   = state.collateralCid
      paymentCashCids = [state.borrowerCashCid]


-- 2.2: Correct asset name with wrong issuer MUST FAIL
testCorrectAssetNameWrongIssuerFails : Script ()
testCorrectAssetNameWrongIssuerFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  fakeIssuer <- allocateParty "FakeIssuer"

  -- Fake cash has name "USD-TEST" but was signed/issued by fakeIssuer
  fakeCashCid <- submit fakeIssuer do
    createCmd CashHolding with
      owner        = borrower
      operator     = fakeIssuer
      instrument   = "USD-TEST"
      amount       = 5000.0
      allocatedFor = None

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = fakeCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Must fail because operator does not match expectedOperator
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


-- 2.3: Excess funding MUST return change to Lender B
testExcessFundingReturnsChange : Script ()
testExcessFundingReturnsChange = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  -- Lender B has 150,000 USD-TEST (50,000 more than needed)
  bigLenderBCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderB
      operator
      instrument   = "USD-TEST"
      amount       = 150000.0
      allocatedFor = None

  allocatedBigCashCid <- submit lenderB do
    exerciseCmd bigLenderBCashCid Allocate with
      forParty = borrower

  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA
      borrower
      expectedOperator  = operator
      expectedRecipient = lenderA
      expectedLocker    = lenderB
      loanACid          = state.loanACid
      payoffAmount      = 101000.0
      instrument        = "USD-TEST"
      expiresAt         = tExpiry

  -- Offer specifies 100,000 newPrincipal, but references 150,000 cash contract
  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB
      borrower
      operator
      expectedRecipient    = lenderA
      newPrincipal         = 100000.0
      maturityDate         = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = allocatedBigCashCid
      cashInstrument       = "USD-TEST"
      expiresAt            = tExpiry
      capRate              = 0.075
      amortizationPeriods  = 24

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid
      replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Execute closing
  _ <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- Lender A receives exactly 101,000 USD-TEST
  lenderAHoldings <- queryFilter @CashHolding lenderA (\h -> h.owner == lenderA)
  let totalLenderACash = sum (map (\(_, h) -> h.amount) lenderAHoldings)
  assert (totalLenderACash == 101000.0)

  -- Lender B retains 50,000 USD-TEST change holding (+ initial 100k holding if any)
  lenderBHoldings <- queryFilter @CashHolding lenderB (\h -> h.owner == lenderB)
  let totalLenderBCash = sum (map (\(_, h) -> h.amount) lenderBHoldings)
  -- 100,000 from state + 50,000 change = 150,000
  assert (totalLenderBCash == 150000.0)


-- 2.4: Collateral reuse with fresh offers MUST FAIL
testCollateralReuseWithFreshOffersFails : Script ()
testCollateralReuseWithFreshOffersFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- 1. Execute first closing successfully
  _ <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- 2. Fresh offer arrives from a third lender
  lenderC <- allocateParty "LenderC"
  lenderCCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderC
      operator
      instrument   = "USD-TEST"
      amount       = 100000.0
      allocatedFor = None

  freshOfferCid <- submit lenderC do
    createCmd ReplacementOffer with
      lenderB              = lenderC
      borrower
      operator
      expectedRecipient    = lenderA
      newPrincipal         = 100000.0
      maturityDate         = date 2030 Dec 31
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = lenderCCashCid
      cashInstrument       = "USD-TEST"
      expiresAt            = tExpiry
      capRate              = 0.065
      amortizationPeriods  = 36

  -- Borrower attempts to reuse the already-bound collateral (state.collateralCid)
  freshClosingReqCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB             = lenderC
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = freshOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Must fail because collateral and approvals were already consumed
  submitMustFail borrower do
    exerciseCmd freshClosingReqCid Execute


