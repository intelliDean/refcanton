-- TestRefinancing.daml
-- Ref Canton: Private Refinancing App
-- Comprehensive automated test script verifying:
-- 1. Happy path: Atomic closing (101,000 payoff, 100k new loan, 1k contribution, 150 collateral units moved)
-- 2. Before/after ledger balances & loan states
-- 3. Failure cases: insufficient borrower funds, replay attempts, expired approvals
-- 4. Privacy verification: LenderA cannot see B's private terms, LenderB cannot see A's private terms
-- Satisfies ref_canton.txt: "The initial proof becomes the submission's core backend" (spec line 5, 8, 17-22)

module TestRefinancing where

import Daml.Script
import DA.Date (date, Month(..))
import DA.Time (time)
import Assets
import Loan
import Approvals
import Closing

testRefinancingLifecycle : Script ()
testRefinancingLifecycle = script do
  operator <- allocateParty "Operator"
  borrower <- allocateParty "Borrower"
  lenderA  <- allocateParty "LenderA"
  lenderB  <- allocateParty "LenderB"

  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0

  setTime t0

  -- ───────────────────────────────────────────────────────────────────────────
  -- 1. INITIAL STATE SETUP
  -- ───────────────────────────────────────────────────────────────────────────
  -- Borrower has 5,000 USD-TEST cash
  borrowerCashCid <- submit operator do
    createCmd CashHolding with
      owner        = borrower
      operator
      instrument   = "USD-TEST"
      amount       = 5000.0
      allocatedFor = None

  -- LenderB has 100,000 USD-TEST cash ready to deploy
  lenderBCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderB
      operator
      instrument   = "USD-TEST"
      amount       = 100000.0
      allocatedFor = None

  -- Borrower has 150 COLLAT-TEST units, locked to LenderA
  freeCollateralCid <- submitMulti [operator, borrower] [] do
    createCmd CollateralHolding with
      owner      = borrower
      operator
      instrument = "COLLAT-TEST"
      amount     = 150.0

  lockedCollateralCid <- submit borrower do
    exerciseCmd freeCollateralCid Lock with
      locker  = lenderA
      context = "LoanA-collateral"

  -- LoanA exists (101,000 payoff principal, 8.5% annual rate)
  loanACid <- submitMulti [borrower, lenderA] [] do
    createCmd LoanA with
      borrower
      lenderA
      operator
      principal       = 101000.0
      maturityDate    = date 2027 Jun 30
      collateralCid   = lockedCollateralCid
      annualRate      = 0.085
      originationDate = date 2024 Jun 30

  -- Verify initial state
  Some loanA <- queryContractId borrower loanACid
  assert (loanA.principal == 101000.0)
  assert (loanA.lenderA == lenderA)

  -- ───────────────────────────────────────────────────────────────────────────
  -- 2. BINDING APPROVALS
  -- ───────────────────────────────────────────────────────────────────────────
  -- LenderA issues PayoffQuote for 101,000
  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA
      borrower
      loanACid
      payoffAmount = 101000.0
      instrument   = "USD-TEST"
      expiresAt    = tExpiry

  -- LenderB prepares funding allocation for borrower
  allocatedLenderBCashCid <- submit lenderB do
    exerciseCmd lenderBCashCid Allocate with
      forParty = borrower

  -- LenderB issues ReplacementOffer for 100,000 (with private capRate 7.5%)
  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB
      borrower
      operator
      newPrincipal         = 100000.0
      maturityDate         = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = allocatedLenderBCashCid
      cashInstrument       = "USD-TEST"
      expiresAt            = tExpiry
      capRate              = 0.075
      amortizationPeriods  = 24

  -- ───────────────────────────────────────────────────────────────────────────
  -- 3. CLOSING INITIATION & ATOMIC EXECUTION
  -- ───────────────────────────────────────────────────────────────────────────
  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid
      replacementOfferCid
      borrowerCashCid
      loanACid
      collateralCid = lockedCollateralCid

  -- Execute atomic closing
  receiptCid <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- ───────────────────────────────────────────────────────────────────────────
  -- 4. VERIFY FINAL LEDGER STATE
  -- ───────────────────────────────────────────────────────────────────────────
  -- A. LoanA must be archived
  loanAAfter <- queryContractId borrower loanACid
  assert (loanAAfter == None)

  -- B. LoanB must exist with 100,000 principal
  receiptContract <- queryContractId borrower receiptCid
  let Some rc = receiptContract
  let newLoanBCid = rc.receipt.loanBCid

  Some loanB <- queryContractId borrower newLoanBCid
  assert (loanB.principal == 100000.0)
  assert (loanB.lenderB == lenderB)
  assert (loanB.borrower == borrower)

  -- C. Collateral must now be locked to LenderB (150 units)
  Some newCollateral <- queryContractId borrower loanB.collateralCid
  assert (newCollateral.locker == lenderB)
  assert (newCollateral.amount == 150.0)
  assert (newCollateral.owner == borrower)

  -- D. LenderA received 101,000 USD-TEST in total (100,000 from B + 1,000 from borrower)
  lenderAHoldings <- queryFilter @CashHolding lenderA (\h -> h.owner == lenderA)
  let totalLenderACash = sum (map (\(_, h) -> h.amount) lenderAHoldings)
  assert (totalLenderACash == 101000.0)

  -- E. Borrower spent 1,000 and has 4,000 remaining
  borrowerHoldings <- queryFilter @CashHolding borrower (\h -> h.owner == borrower)
  let totalBorrowerCash = sum (map (\(_, h) -> h.amount) borrowerHoldings)
  assert (totalBorrowerCash == 4000.0)

  -- ───────────────────────────────────────────────────────────────────────────
  -- 5. PRIVACY AUDIT (Query active contracts as each lender)
  -- Satisfies ref_canton.txt line 20: "A cannot see B's private rate/maturity; B cannot see A's private historical terms."
  -- ───────────────────────────────────────────────────────────────────────────
  -- LenderA CANNOT query LoanB
  loanBFromA <- queryContractId lenderA newLoanBCid
  assertMsg "Privacy breach: LenderA must not see LoanB" (loanBFromA == None)

  -- LenderB CANNOT query LoanA historical terms
  loanAFromB <- queryContractId lenderB loanACid
  assertMsg "Privacy breach: LenderB must not see LoanA" (loanAFromB == None)

  return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- FAILURE TEST CASES
-- Satisfies ref_canton.txt line 21-22:
-- "Insufficient funds, expired/changed approvals, replay and direct collateral-release bypass attempts cannot produce a partial or unsecured result."
-- ─────────────────────────────────────────────────────────────────────────────

testInsufficientBorrowerFundsFails : Script ()
testInsufficientBorrowerFundsFails = script do
  operator <- allocateParty "Operator"
  borrower <- allocateParty "Borrower"
  lenderA  <- allocateParty "LenderA"
  lenderB  <- allocateParty "LenderB"

  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  -- Borrower only has 500 USD-TEST (needs 1,000)
  poorBorrowerCashCid <- submit operator do
    createCmd CashHolding with
      owner        = borrower
      operator
      instrument   = "USD-TEST"
      amount       = 500.0
      allocatedFor = None

  lenderBCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderB
      operator
      instrument   = "USD-TEST"
      amount       = 100000.0
      allocatedFor = None

  allocatedLenderBCashCid <- submit lenderB do
    exerciseCmd lenderBCashCid Allocate with
      forParty = borrower

  freeCollateralCid <- submitMulti [operator, borrower] [] do
    createCmd CollateralHolding with
      owner      = borrower
      operator
      instrument = "COLLAT-TEST"
      amount     = 150.0

  lockedCollateralCid <- submit borrower do
    exerciseCmd freeCollateralCid Lock with
      locker  = lenderA
      context = "LoanA-collateral"

  loanACid <- submitMulti [borrower, lenderA] [] do
    createCmd LoanA with
      borrower; lenderA; operator
      principal       = 101000.0
      maturityDate    = date 2027 Jun 30
      collateralCid   = lockedCollateralCid
      annualRate      = 0.085
      originationDate = date 2024 Jun 30

  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA; borrower; loanACid; payoffAmount = 101000.0; instrument = "USD-TEST"; expiresAt = tExpiry

  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB; borrower; operator; newPrincipal = 100000.0; maturityDate = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"; collateralUnits = 150.0; lenderBCashCid = allocatedLenderBCashCid
      cashInstrument = "USD-TEST"; expiresAt = tExpiry; capRate = 0.075; amortizationPeriods = 24

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower; lenderA; lenderB; operator
      payoffQuoteCid; replacementOfferCid; borrowerCashCid = poorBorrowerCashCid
      loanACid; collateralCid = lockedCollateralCid

  -- Must fail because borrower lacks 1,000 USD-TEST
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


testExpiredApprovalFails : Script ()
testExpiredApprovalFails = script do
  operator <- allocateParty "Operator"
  borrower <- allocateParty "Borrower"
  lenderA  <- allocateParty "LenderA"
  lenderB  <- allocateParty "LenderB"

  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  borrowerCashCid <- submit operator do
    createCmd CashHolding with
      owner        = borrower
      operator
      instrument   = "USD-TEST"
      amount       = 5000.0
      allocatedFor = None

  lenderBCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderB
      operator
      instrument   = "USD-TEST"
      amount       = 100000.0
      allocatedFor = None

  allocatedLenderBCashCid <- submit lenderB do
    exerciseCmd lenderBCashCid Allocate with
      forParty = borrower

  freeCollateralCid <- submitMulti [operator, borrower] [] do
    createCmd CollateralHolding with
      owner      = borrower
      operator
      instrument = "COLLAT-TEST"
      amount     = 150.0

  lockedCollateralCid <- submit borrower do
    exerciseCmd freeCollateralCid Lock with
      locker  = lenderA
      context = "LoanA-collateral"

  loanACid <- submitMulti [borrower, lenderA] [] do
    createCmd LoanA with
      borrower; lenderA; operator
      principal       = 101000.0
      maturityDate    = date 2027 Jun 30
      collateralCid   = lockedCollateralCid
      annualRate      = 0.085
      originationDate = date 2024 Jun 30

  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA; borrower; loanACid; payoffAmount = 101000.0; instrument = "USD-TEST"; expiresAt = tExpiry

  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB; borrower; operator; newPrincipal = 100000.0; maturityDate = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"; collateralUnits = 150.0; lenderBCashCid = allocatedLenderBCashCid
      cashInstrument = "USD-TEST"; expiresAt = tExpiry; capRate = 0.075; amortizationPeriods = 24

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower; lenderA; lenderB; operator
      payoffQuoteCid; replacementOfferCid; borrowerCashCid
      loanACid; collateralCid = lockedCollateralCid

  -- Fast-forward past expiry time
  setTime (time (date 2026 Jul 27) 0 0 0)

  -- Must fail because quote and offer have expired
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute
