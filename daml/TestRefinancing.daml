-- TestRefinancing.daml
-- Ref Canton: Private Refinancing App
-- Comprehensive automated test script verifying:
-- 1. Happy path: Atomic closing (101,000 payoff, 100k new loan, 1k contribution, 150 collateral units moved)
-- 2. Before/after ledger balances & loan states
-- 3. Failure cases: insufficient borrower funds, replay attempts, expired approvals
-- 4. Privacy verification: LenderA cannot see B's private terms, LenderB cannot see A's private terms
-- 5. Revocation & cancellation safety: Quote revocation, offer withdrawal, closing cancellation
-- Satisfies ref_canton.txt: "The initial proof becomes the submission's core backend" (spec line 5, 8, 17-22, 33)

module TestRefinancing where

import Daml.Script
import DA.Date (date, Month(..))
import DA.Time (time)
import Assets
import Loan
import Approvals
import Closing
import Setup (TestParties(..), InitialLedgerState(..), initializeLedger, initializeLedgerWithBorrowerCash)

-- ─────────────────────────────────────────────────────────────────────────────
-- TEST FIXTURE HELPERS
-- ─────────────────────────────────────────────────────────────────────────────

data TestApprovals = TestApprovals
  with
    payoffQuoteCid          : ContractId PayoffQuote
    replacementOfferCid     : ContractId ReplacementOffer
    allocatedLenderBCashCid : ContractId CashHolding
  deriving (Eq, Show)

-- Helper to set up active binding PayoffQuote and ReplacementOffer
setupApprovals : TestParties -> InitialLedgerState -> Time -> Script TestApprovals
setupApprovals parties state tExpiry = do
  let TestParties{operator, borrower, lenderA, lenderB} = parties
  let InitialLedgerState{loanACid, lenderBCashCid} = state

  -- LenderA issues PayoffQuote for 101,000 USD-TEST
  payoffQuoteCid <- submit lenderA do
    createCmd PayoffQuote with
      lenderA
      borrower
      loanACid
      payoffAmount = 101000.0
      instrument   = "USD-TEST"
      expiresAt    = tExpiry

  -- LenderB prepares funding allocation for borrower
  allocatedLenderBCashCid <- submit lenderB do
    exerciseCmd lenderBCashCid Allocate with
      forParty = borrower

  -- LenderB issues ReplacementOffer for 100,000 USD-TEST (with private capRate 7.5%)
  replacementOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB
      borrower
      operator
      newPrincipal         = 100000.0
      maturityDate         = date 2029 Dec 31
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = allocatedLenderBCashCid
      cashInstrument       = "USD-TEST"
      expiresAt            = tExpiry
      capRate              = 0.075
      amortizationPeriods  = 24

  return TestApprovals with
    payoffQuoteCid
    replacementOfferCid
    allocatedLenderBCashCid


-- ─────────────────────────────────────────────────────────────────────────────
-- 1. HAPPY PATH: Full Refinancing Lifecycle
-- ─────────────────────────────────────────────────────────────────────────────

testRefinancingLifecycle : Script ()
testRefinancingLifecycle = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  -- 1. INITIAL STATE SETUP
  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  -- Verify initial state
  Some loanA <- queryContractId borrower state.loanACid
  assert (loanA.principal == 101000.0)
  assert (loanA.lenderA == lenderA)

  -- 2. BINDING APPROVALS
  approvals <- setupApprovals state.parties state tExpiry

  -- 3. CLOSING INITIATION & ATOMIC EXECUTION
  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Execute atomic closing
  receiptCid <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- 4. VERIFY FINAL LEDGER STATE
  -- A. LoanA must be archived
  loanAAfter <- queryContractId borrower state.loanACid
  assert (loanAAfter == None)

  -- B. LoanB must exist with 100,000 principal
  receiptContract <- queryContractId borrower receiptCid
  let Some rc = receiptContract
  let newLoanBCid = rc.receipt.loanBCid

  Some loanB <- queryContractId borrower newLoanBCid
  assert (loanB.principal == 100000.0)
  assert (loanB.lenderB == lenderB)
  assert (loanB.borrower == borrower)

  -- C. Collateral must now be locked to LenderB (150 units)
  Some newCollateral <- queryContractId borrower loanB.collateralCid
  assert (newCollateral.locker == lenderB)
  assert (newCollateral.amount == 150.0)
  assert (newCollateral.owner == borrower)

  -- D. LenderA received 101,000 USD-TEST in total (100,000 from B + 1,000 from borrower)
  lenderAHoldings <- queryFilter @CashHolding lenderA (\h -> h.owner == lenderA)
  let totalLenderACash = sum (map (\(_, h) -> h.amount) lenderAHoldings)
  assert (totalLenderACash == 101000.0)

  -- E. Borrower spent 1,000 and has 4,000 remaining
  borrowerHoldings <- queryFilter @CashHolding borrower (\h -> h.owner == borrower)
  let totalBorrowerCash = sum (map (\(_, h) -> h.amount) borrowerHoldings)
  assert (totalBorrowerCash == 4000.0)

  -- 5. PRIVACY AUDIT (Query active contracts as each lender)
  -- LenderA CANNOT query LoanB
  loanBFromA <- queryContractId lenderA newLoanBCid
  assertMsg "Privacy breach: LenderA must not see LoanB" (loanBFromA == None)

  -- LenderB CANNOT query LoanA historical terms
  loanAFromB <- queryContractId lenderB state.loanACid
  assertMsg "Privacy breach: LenderB must not see LoanA" (loanAFromB == None)

  return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- 2. FAILURE TEST CASES
-- ─────────────────────────────────────────────────────────────────────────────

testInsufficientBorrowerFundsFails : Script ()
testInsufficientBorrowerFundsFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  -- Borrower only has 500 USD-TEST (needs 1,000 equity contribution)
  state <- initializeLedgerWithBorrowerCash 500.0
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Must fail because borrower lacks 1,000 USD-TEST
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


testExpiredApprovalFails : Script ()
testExpiredApprovalFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Fast-forward past expiry time
  setTime (time (date 2026 Jul 27) 0 0 0)

  -- Must fail because quote and offer have expired
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


testQuoteRevocationFails : Script ()
testQuoteRevocationFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- LenderA revokes their quote before closing
  submit lenderA do
    exerciseCmd approvals.payoffQuoteCid WithdrawQuote

  -- Execution must fail because quote was revoked
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


testOfferWithdrawalFails : Script ()
testOfferWithdrawalFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- LenderB withdraws their offer
  submit lenderB do
    exerciseCmd approvals.replacementOfferCid WithdrawOffer

  -- LenderB deallocates their cash back to general balance
  reclaimedCashCid <- submit lenderB do
    exerciseCmd approvals.allocatedLenderBCashCid Deallocate

  Some bCash <- queryContractId lenderB reclaimedCashCid
  assert (bCash.amount == 100000.0)
  assert (bCash.allocatedFor == None)

  -- Execution must fail because offer was withdrawn
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


testBorrowerCancelFails : Script ()
testBorrowerCancelFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Borrower cancels the closing request
  submit borrower do
    exerciseCmd closingRequestCid Cancel

  -- Execution must fail because closing request was cancelled and archived
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute


-- ─────────────────────────────────────────────────────────────────────────────
-- 3. EVIDENCE TESTS: UNAUTHORIZED RELEASE, WRONG ASSETS, REPLAY, AND PRIVACY
-- ─────────────────────────────────────────────────────────────────────────────

-- 3.1: Unauthorized Collateral Release:
-- Proves that neither borrower, incoming lender (lenderB), nor operator can unlock
-- or repledge collateral pledged to lenderA without lenderA's explicit authorization.
testUnauthorizedCollateralReleaseFails : Script ()
testUnauthorizedCollateralReleaseFails = script do
  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  -- Verify initial state: collateral is locked to lenderA
  Some lockedCollat <- queryContractId borrower state.collateralCid
  assert (lockedCollat.locker == lenderA)
  assert (lockedCollat.amount == 150.0)

  -- A. Borrower attempts direct Unlock (must fail authorization)
  submitMustFail borrower do
    exerciseCmd state.collateralCid Unlock

  -- B. Borrower attempts direct Repledge to lenderB (must fail authorization)
  submitMustFail borrower do
    exerciseCmd state.collateralCid Repledge with
      newLocker  = lenderB
      newContext = "Malicious-Repledge"

  -- C. LenderB attempts direct Unlock (must fail authorization)
  submitMustFail lenderB do
    exerciseCmd state.collateralCid Unlock

  -- D. LenderB attempts direct Repledge to themselves (must fail authorization)
  submitMustFail lenderB do
    exerciseCmd state.collateralCid Repledge with
      newLocker  = lenderB
      newContext = "LenderB-Theft"

  -- E. Operator attempts direct Unlock (must fail authorization)
  submitMustFail operator do
    exerciseCmd state.collateralCid Unlock

  -- Collateral remains safely locked to LenderA
  Some stillLocked <- queryContractId lenderA state.collateralCid
  assert (stillLocked.locker == lenderA)


-- 3.2: Wrong Asset Identifiers:
-- Proves that attempting to settle with counterfeit or mismatched cash/collateral instruments aborts.
testWrongAssetFails : Script ()
testWrongAssetFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  -- Scenario A: Borrower passes counterfeit cash ("USD-COUNTERFEIT")
  fakeBorrowerCashCid <- submit operator do
    createCmd CashHolding with
      owner        = borrower
      operator
      instrument   = "USD-COUNTERFEIT"
      amount       = 5000.0
      allocatedFor = None

  approvalsA <- setupApprovals state.parties state tExpiry

  closingRequestFakeCash <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvalsA.payoffQuoteCid
      replacementOfferCid = approvalsA.replacementOfferCid
      borrowerCashCid     = fakeBorrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Closing must fail because borrower cash instrument is not USD-TEST
  submitMustFail borrower do
    exerciseCmd closingRequestFakeCash Execute

  -- Scenario B: LenderB offers counterfeit cash ("EUR-TEST")
  fakeLenderBCashCid <- submit operator do
    createCmd CashHolding with
      owner        = lenderB
      operator
      instrument   = "EUR-TEST"
      amount       = 100000.0
      allocatedFor = None

  allocatedFakeCash <- submit lenderB do
    exerciseCmd fakeLenderBCashCid Allocate with forParty = borrower

  badOfferCid <- submit lenderB do
    createCmd ReplacementOffer with
      lenderB
      borrower
      operator
      newPrincipal         = 100000.0
      maturityDate         = date 2028 Jul 25
      collateralInstrument = "COLLAT-TEST"
      collateralUnits      = 150.0
      lenderBCashCid       = allocatedFakeCash
      cashInstrument       = "EUR-TEST"
      expiresAt            = tExpiry
      capRate              = 0.075
      amortizationPeriods  = 24

  closingRequestBadOffer <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvalsA.payoffQuoteCid
      replacementOfferCid = badOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Closing must fail because replacement offer cash instrument is not USD-TEST
  submitMustFail borrower do
    exerciseCmd closingRequestBadOffer Execute


-- 3.3: Replay Attack:
-- Proves that once an atomic closing executes, neither the ClosingRequest nor the consumed
-- approval contracts can be replayed or double-spent.
testReplayAttackFails : Script ()
testReplayAttackFails = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- 1. Execute first atomic closing (succeeds)
  receiptCid <- submit borrower do
    exerciseCmd closingRequestCid Execute

  Some _ <- queryContractId borrower receiptCid

  -- 2. REPLAY ATTACK ATTEMPT 1: Re-executing the already consumed ClosingRequest
  submitMustFail borrower do
    exerciseCmd closingRequestCid Execute

  -- 3. REPLAY ATTACK ATTEMPT 2: Attempting to execute a second ClosingRequest using
  -- already-consumed PayoffQuote and ReplacementOffer
  replayedClosingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  -- Replay execution must fail because approval contracts and loans are already consumed and archived
  submitMustFail borrower do
    exerciseCmd replayedClosingRequestCid Execute


-- 3.4: Privacy Checks with Separate Lender Credentials & Transaction History:
-- Proves asymmetric contract visibility: LenderA queries return 0 results for LenderB's
-- terms, and LenderB queries return 0 results for LenderA's terms.
testPrivacyWithSeparateLenderCredentials : Script ()
testPrivacyWithSeparateLenderCredentials = script do
  let t0 = time (date 2026 Jul 25) 10 0 0
  let tExpiry = time (date 2026 Jul 26) 18 0 0
  setTime t0

  state <- initializeLedger
  let TestParties{operator, borrower, lenderA, lenderB} = state.parties

  approvals <- setupApprovals state.parties state tExpiry

  -- Prior to close:
  -- LenderA sees PayoffQuote, LoanA.
  lenderAPayoffQuotes <- queryFilter @PayoffQuote lenderA (\q -> q.lenderA == lenderA)
  assert (length lenderAPayoffQuotes == 1)

  -- LenderA CANNOT see ReplacementOffer (must be 0 results)
  lenderAOffers <- queryFilter @ReplacementOffer lenderA (\_ -> True)
  assertMsg "Privacy breach: LenderA queried ReplacementOffer" (null lenderAOffers)

  -- LenderB sees ReplacementOffer.
  lenderBOffers <- queryFilter @ReplacementOffer lenderB (\o -> o.lenderB == lenderB)
  assert (length lenderBOffers == 1)

  -- LenderB CANNOT see PayoffQuote (must be 0 results)
  lenderBQuotes <- queryFilter @PayoffQuote lenderB (\_ -> True)
  assertMsg "Privacy breach: LenderB queried PayoffQuote" (null lenderBQuotes)

  -- LenderB CANNOT see LoanA (must be 0 results)
  lenderBLoanA <- queryFilter @LoanA lenderB (\_ -> True)
  assertMsg "Privacy breach: LenderB queried LoanA" (null lenderBLoanA)

  -- Execute atomic closing
  closingRequestCid <- submit borrower do
    createCmd ClosingRequest with
      borrower
      lenderA
      lenderB
      operator
      payoffQuoteCid      = approvals.payoffQuoteCid
      replacementOfferCid = approvals.replacementOfferCid
      borrowerCashCid     = state.borrowerCashCid
      loanACid            = state.loanACid
      collateralCid       = state.collateralCid

  _ <- submit borrower do
    exerciseCmd closingRequestCid Execute

  -- Post-close Privacy Inspection:
  -- LenderA STILL cannot see LoanB
  lenderALoanB <- queryFilter @LoanB lenderA (\_ -> True)
  assertMsg "Privacy breach: LenderA queried LoanB post-close" (null lenderALoanB)

  -- LenderB STILL cannot see LoanA historical terms
  lenderBLoanAPost <- queryFilter @LoanA lenderB (\_ -> True)
  assertMsg "Privacy breach: LenderB queried LoanA post-close" (null lenderBLoanAPost)

