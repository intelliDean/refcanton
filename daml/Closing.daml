-- Closing.daml
-- Ref Canton: Private Refinancing App
-- The ClosingRequest template executes the atomic close in one committed ledger transaction.
-- Satisfies: "Atomic closing: One committed update pays A 101,000, closes A's loan, creates B's 100,000 loan and secures it with the 150 collateral units."
-- Role-isolated receipts: Lender A and Lender B only receive receipts for their respective legs,
-- preserving sub-transaction privacy.

module Closing where

import Assets
import Loan
import Approvals

-- ─────────────────────────────────────────────────────────────────────────────
-- ROLE-ISOLATED CLOSING RECEIPTS
-- ─────────────────────────────────────────────────────────────────────────────

-- Lender A Payoff Receipt: Visible to Lender A + Borrower ONLY.
-- Excludes all terms, amounts, and contract IDs of Lender B.
template LenderAPayoffReceipt
  with
    borrower                : Party
    lenderA                 : Party
    loanACid                : ContractId LoanA
    payoffAmount            : Decimal
    collateralUnitsReleased : Decimal
    closedAt                : Time
  where
    signatory borrower
    observer  lenderA

-- Lender B Funding Receipt: Visible to Lender B + Borrower ONLY.
-- Excludes all payoff amounts, equity contributions, and contract IDs of Lender A.
template LenderBFundingReceipt
  with
    borrower               : Party
    lenderB                : Party
    loanBCid               : ContractId LoanB
    principalFunded        : Decimal
    collateralUnitsSecured : Decimal
    closedAt               : Time
  where
    signatory borrower
    observer  lenderB

-- Borrower Closing Receipt: Full reconciliation audit record, visible to Borrower ONLY.
template BorrowerClosingReceipt
  with
    borrower             : Party
    loanACid             : ContractId LoanA
    loanBCid             : ContractId LoanB
    payoffAmount         : Decimal
    newPrincipal         : Decimal
    borrowerContribution : Decimal
    collateralUnits      : Decimal
    closedAt             : Time
  where
    signatory borrower


-- ─────────────────────────────────────────────────────────────────────────────
-- CLOSING REQUEST
-- Borrower initiates this contract after receiving binding approvals from both lenders.
-- Stakeholders: signatory borrower ONLY.
-- NO observer lenderA, lenderB — this ensures Canton's sub-transaction privacy tree
-- keeps each lender isolated to its own branch of the execution.
-- ─────────────────────────────────────────────────────────────────────────────

template ClosingRequest
  with
    borrower            : Party
    lenderA             : Party
    lenderB             : Party
    operator            : Party
    payoffQuoteCid      : ContractId PayoffQuote
    replacementOfferCid : ContractId ReplacementOffer
    borrowerCashCid     : ContractId CashHolding
    loanACid            : ContractId LoanA
    collateralCid       : ContractId LockedCollateralHolding
  where
    signatory borrower

    -- Borrower can cancel before execution
    choice Cancel : ()
      controller borrower
      do return ()

    -- ─────────────────────────────────────────────────────────────────────────
    -- THE ATOMIC CLOSE
    -- Single transaction tree: all steps commit together or revert together.
    -- ─────────────────────────────────────────────────────────────────────────
    choice Execute : (ContractId LenderAPayoffReceipt, ContractId LenderBFundingReceipt, ContractId BorrowerClosingReceipt)
      controller borrower
      do
        -- Step 1: Verify borrower has required 1,000 contribution and valid instrument
        borrowerCash <- fetch borrowerCashCid
        assertMsg "Borrower cash insufficient (need 1,000 USD-TEST)"
          (borrowerCash.amount >= 1000.0)
        assertMsg "Borrower cash instrument must be USD-TEST"
          (borrowerCash.instrument == "USD-TEST")
        assertMsg "Borrower cash operator mismatch"
          (borrowerCash.operator == operator)

        -- Step 2: Validate both approval contracts, instruments, and reconcile numbers
        quote <- fetch payoffQuoteCid
        offer <- fetch replacementOfferCid
        assertMsg "Payoff quote lender mismatch" (quote.lenderA == lenderA)
        assertMsg "Replacement offer lender mismatch" (offer.lenderB == lenderB)
        assertMsg "Payoff quote instrument must be USD-TEST" (quote.instrument == "USD-TEST")
        assertMsg "Replacement offer cash instrument must be USD-TEST" (offer.cashInstrument == "USD-TEST")
        assertMsg "Replacement offer collateral instrument must be COLLAT-TEST" (offer.collateralInstrument == "COLLAT-TEST")
        assertMsg "Reconciliation: B's principal + borrower 1,000 == A's payoff"
          (offer.newPrincipal + 1000.0 == quote.payoffAmount)
        assertMsg "Collateral match: offer matches loan collateral units"
          (offer.collateralUnits == 150.0)

        -- Step 3: Transfer borrower's 1,000 contribution to lenderA
        (borrowerPaymentToA, _) <- exercise borrowerCashCid TransferPartial with
          recipient      = lenderA
          transferAmount = 1000.0

        -- Step 4: Atomically disburse Lender B funds, settle Loan A, and secure collateral to Loan B
        (_lenderBPaymentToA, loanBCid) <- exercise replacementOfferCid DisburseAndSecure with
          payoffQuoteCid
          borrowerPaymentToA
          currentCollateralCid = collateralCid

        -- Step 5: Issue role-isolated receipts
        now <- getTime
        receiptA <- create LenderAPayoffReceipt with
          borrower
          lenderA
          loanACid
          payoffAmount            = quote.payoffAmount
          collateralUnitsReleased = offer.collateralUnits
          closedAt                = now

        receiptB <- create LenderBFundingReceipt with
          borrower
          lenderB
          loanBCid
          principalFunded        = offer.newPrincipal
          collateralUnitsSecured = offer.collateralUnits
          closedAt               = now

        receiptBorrower <- create BorrowerClosingReceipt with
          borrower
          loanACid
          loanBCid
          payoffAmount         = quote.payoffAmount
          newPrincipal         = offer.newPrincipal
          borrowerContribution = 1000.0
          collateralUnits      = offer.collateralUnits
          closedAt             = now

        return (receiptA, receiptB, receiptBorrower)
