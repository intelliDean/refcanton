-- TestPrivacyAudit.daml
-- Ref Canton: Privacy Verification Across Distinct Participant Nodes
-- Queries Participant 2 (Lender A) and Participant 3 (Lender B) to prove sub-transaction privacy

module TestPrivacyAudit where

import Daml.Script
import Loan
import Approvals
import Closing

auditParticipant2 : Script ()
auditParticipant2 = script do
  parties <- listKnownParties
  debug ("=== PARTICIPANT 2 (LENDER A) PRIVACY AUDIT ===")
  debug ("Node Known Parties Count:", length parties)

  -- Get LenderA party on Participant 2
  lenderA <- allocateParty "LenderA"

  -- Query contracts visible to LenderA on Participant 2
  receipts <- query @ClosingReceiptContract lenderA
  debug ("Participant 2 Visible Closing Receipts:", length receipts)

  loansB <- query @LoanB lenderA
  debug ("Participant 2 Visible LoanB (Expected 0):", length loansB)
  assertMsg "Privacy Violation: Participant 2 sees LoanB" (null loansB)

  offers <- query @ReplacementOffer lenderA
  debug ("Participant 2 Visible ReplacementOffer (Expected 0):", length offers)
  assertMsg "Privacy Violation: Participant 2 sees ReplacementOffer" (null offers)
  debug ("✓ PRIVACY CHECK PASSED: Lender A has ZERO visibility into Lender B terms!")

auditParticipant3 : Script ()
auditParticipant3 = script do
  parties <- listKnownParties
  debug ("=== PARTICIPANT 3 (LENDER B) PRIVACY AUDIT ===")
  debug ("Node Known Parties Count:", length parties)

  -- Get LenderB party on Participant 3
  lenderB <- allocateParty "LenderB"

  receipts <- query @ClosingReceiptContract lenderB
  debug ("Participant 3 Visible Closing Receipts:", length receipts)

  loansA <- query @LoanA lenderB
  debug ("Participant 3 Visible LoanA (Expected 0):", length loansA)
  assertMsg "Privacy Violation: Participant 3 sees LoanA" (null loansA)

  quotes <- query @PayoffQuote lenderB
  debug ("Participant 3 Visible PayoffQuote (Expected 0):", length quotes)
  assertMsg "Privacy Violation: Participant 3 sees PayoffQuote" (null quotes)
  debug ("✓ PRIVACY CHECK PASSED: Lender B has ZERO visibility into Lender A terms!")
