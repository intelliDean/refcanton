-- TestPrivacyAudit.daml
-- Ref Canton: Privacy Verification Across Distinct Participant Nodes
-- Queries Participant 2 (Lender A) and Participant 3 (Lender B) to prove sub-transaction privacy

module TestPrivacyAudit where

import Daml.Script
import Loan
import Approvals
import Closing
import TestLiveCanton (runLiveRefinancing)

auditParticipant2 : Script ()
auditParticipant2 = script do
  result <- runLiveRefinancing
  let lenderA = result.parties.lenderA

  -- 1. Confirm Lender A sees its own expected records first
  receiptsA <- queryFilter @LenderAPayoffReceipt lenderA (\r -> r.lenderA == lenderA)
  debug ("Participant 2 Visible Lender A Receipts:", length receiptsA)
  assertMsg "Lender A expected to see its own payoff receipt" (not (null receiptsA))

  -- 2. Confirm competitor private terms are strictly hidden from Lender A
  loansB <- queryFilter @LoanB lenderA (\_ -> True)
  debug ("Participant 2 Visible LoanB (Expected 0):", length loansB)
  assertMsg "Privacy Violation: Participant 2 sees LoanB" (null loansB)

  offers <- queryFilter @ReplacementOffer lenderA (\_ -> True)
  debug ("Participant 2 Visible ReplacementOffer (Expected 0):", length offers)
  assertMsg "Privacy Violation: Participant 2 sees ReplacementOffer" (null offers)

  receiptsB <- queryFilter @LenderBFundingReceipt lenderA (\_ -> True)
  debug ("Participant 2 Visible LenderBFundingReceipt (Expected 0):", length receiptsB)
  assertMsg "Privacy Violation: Participant 2 sees LenderBFundingReceipt" (null receiptsB)

  borrowerReceipts <- queryFilter @BorrowerClosingReceipt lenderA (\_ -> True)
  debug ("Participant 2 Visible BorrowerClosingReceipt (Expected 0):", length borrowerReceipts)
  assertMsg "Privacy Violation: Participant 2 sees BorrowerClosingReceipt" (null borrowerReceipts)

  debug ("✓ PRIVACY CHECK PASSED: Lender A sees expected payoff record, with ZERO visibility into Lender B terms!")

auditParticipant3 : Script ()
auditParticipant3 = script do
  result <- runLiveRefinancing
  let lenderB = result.parties.lenderB

  -- 1. Confirm Lender B sees its own expected records first
  receiptsB <- queryFilter @LenderBFundingReceipt lenderB (\r -> r.lenderB == lenderB)
  debug ("Participant 3 Visible Lender B Receipts:", length receiptsB)
  assertMsg "Lender B expected to see its own funding receipt" (not (null receiptsB))

  loansB <- queryFilter @LoanB lenderB (\_ -> True)
  debug ("Participant 3 Visible LoanB (Expected 1):", length loansB)
  assertMsg "Lender B expected to see active LoanB" (not (null loansB))

  -- 2. Confirm competitor private terms are strictly hidden from Lender B
  loansA <- queryFilter @LoanA lenderB (\_ -> True)
  debug ("Participant 3 Visible LoanA (Expected 0):", length loansA)
  assertMsg "Privacy Violation: Participant 3 sees LoanA" (null loansA)

  quotes <- queryFilter @PayoffQuote lenderB (\_ -> True)
  debug ("Participant 3 Visible PayoffQuote (Expected 0):", length quotes)
  assertMsg "Privacy Violation: Participant 3 sees PayoffQuote" (null quotes)

  receiptsA <- queryFilter @LenderAPayoffReceipt lenderB (\_ -> True)
  debug ("Participant 3 Visible LenderAPayoffReceipt (Expected 0):", length receiptsA)
  assertMsg "Privacy Violation: Participant 3 sees LenderAPayoffReceipt" (null receiptsA)

  borrowerReceipts <- queryFilter @BorrowerClosingReceipt lenderB (\_ -> True)
  debug ("Participant 3 Visible BorrowerClosingReceipt (Expected 0):", length borrowerReceipts)
  assertMsg "Privacy Violation: Participant 3 sees BorrowerClosingReceipt" (null borrowerReceipts)

  debug ("✓ PRIVACY CHECK PASSED: Lender B sees expected loan and funding records, with ZERO visibility into Lender A terms!")
