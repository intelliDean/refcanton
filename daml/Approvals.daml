-- Approvals.daml
-- Ref Canton: Private Refinancing App
-- PayoffQuote (lenderA's binding release offer) and
-- ReplacementOffer (lenderB's binding funding commitment).
-- Pre-signed authorization contracts that make the atomic close possible.
-- Satisfies: "Binding approvals bind exact parties, loan state, amounts, asset identifiers, recipients, replacement terms and expiry." (spec line 15-16)

module Approvals where

import DA.Foldable (forA_)
import DA.List (dedup)
import Assets
import Loan

-- ─────────────────────────────────────────────────────────────────────────────
-- PAYMENT EVIDENCE
-- Single-use, loan-bound payment evidence produced during debt payoff.
-- SECURITY: lenderA (creditor recipient) and payer are required co-signatories.
-- This makes it impossible for a borrower (or any single party) to self-issue
-- evidence without a genuine cash-transfer operation authorized by the creditor.
-- Any direct creation attempt without lenderA's signature is rejected by Canton.
-- ─────────────────────────────────────────────────────────────────────────────

template PaymentEvidence
  with
    loanACid   : ContractId LoanA   -- strictly bound to the target LoanA contract
    lenderA    : Party              -- recipient of payment (trusted creditor)
    payer      : Party              -- borrower or funding lender who transferred cash
    borrower   : Party              -- authorized borrower to consume evidence
    operator   : Party              -- asset operator
    instrument : Text               -- "USD-TEST"
    amount     : Decimal            -- amount paid towards payoff (must be > 0)
    settledAt  : Time
  where
    signatory lenderA, payer       -- BOTH creditor recipient and payer must co-sign
    observer  borrower

    ensure amount > 0.0            -- zero-value evidence is rejected at creation time

    choice ConsumeEvidence : ()
      controller borrower
      do return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- PAYOFF QUOTE
-- LenderA's binding offer to release LoanA and repledge collateral upon receiving 101,000.
-- Pins: exact loan state, exact amount, exact account, exact expiry.
-- Privacy: visible to lenderA + borrower ONLY. LenderB is structurally excluded.
-- ─────────────────────────────────────────────────────────────────────────────

template PayoffQuote
  with
    lenderA          : Party
    borrower         : Party
    expectedOperator : Party               -- pins asset operator/issuer
    expectedRecipient: Party               -- pins recipient (must be lenderA)
    expectedLocker   : Party               -- pins new locker (must be lenderB)
    loanACid         : ContractId LoanA   -- pins exact loan state (replay protection)
    payoffAmount     : Decimal            -- 101,000.0
    instrument       : Text               -- "USD-TEST"
    expiresAt        : Time               -- hard expiry
  where
    signatory lenderA
    observer  borrower

    ensure payoffAmount > 0.0 && expectedRecipient == lenderA

    -- LenderA revokes the quote prior to borrower triggering execution.
    choice WithdrawQuote : ()
      controller lenderA
      do return ()

    -- Trusted cash-transfer operation: verifies genuine cash, transfers it to lenderA,
    -- and issues non-forgeable PaymentEvidence co-signed by lenderA and payer.
    nonconsuming choice PayTowardsQuote : (ContractId PaymentEvidence, Optional (ContractId CashHolding))
      with
        payer         : Party
        borrowerParty : Party
        cashCid       : ContractId CashHolding
        paymentAmount : Decimal
      controller payer
      do
        now <- getTime
        assertMsg "PayoffQuote has expired" (now < expiresAt)
        assertMsg "Payment amount must be positive" (paymentAmount > 0.0)

        cash <- fetch cashCid
        assertMsg "Cash operator mismatch" (cash.operator == expectedOperator)
        assertMsg "Cash instrument mismatch" (cash.instrument == instrument)
        assertMsg "Cash balance insufficient" (cash.amount >= paymentAmount)
        assertMsg "Payer must own the cash" (cash.owner == payer)

        (transferredCashCid, changeCid) <- if cash.amount == paymentAmount
          then do
            c <- exercise cashCid Transfer with recipient = expectedRecipient
            return (c, None)
          else do
            (c, ch) <- exercise cashCid TransferPartial with
              recipient      = expectedRecipient
              transferAmount = paymentAmount
            return (c, Some ch)

        evidenceCid <- create PaymentEvidence with
          loanACid   = loanACid
          lenderA    = expectedRecipient
          payer      = payer
          borrower   = borrowerParty
          operator   = expectedOperator
          instrument = instrument
          amount     = paymentAmount
          settledAt  = now

        return (evidenceCid, changeCid)

    -- Borrower exercises this INSIDE ClosingRequest.Execute.
    -- Signatory lenderA + controller borrower provide authorization to archive LoanA
    -- and re-pledge the collateral to lenderB upon verified payment.
    choice SettleAndRepledge : ContractId LockedCollateralHolding
      with
        newLocker            : Party
        collateralCid        : ContractId LockedCollateralHolding
        paymentEvidenceCids : [ContractId PaymentEvidence]
        fundedCashCids       : [ContractId CashHolding]
      controller borrower
      do
        now <- getTime
        assertMsg "PayoffQuote has expired" (now < expiresAt)
        assertMsg "Payment list cannot be completely empty"
          (not (null paymentEvidenceCids && null fundedCashCids))
        assertMsg "Duplicate payment evidence IDs not allowed"
          (dedup paymentEvidenceCids == paymentEvidenceCids)
        assertMsg "Duplicate funded cash IDs not allowed"
          (dedup fundedCashCids == fundedCashCids)
        assertMsg "Locker mismatch" (newLocker == expectedLocker)

        evidences <- mapA fetch paymentEvidenceCids
        forA_ evidences $ \ev -> do
          assertMsg "Payment evidence must be bound to this loan" (ev.loanACid == loanACid)
          assertMsg "Payment evidence must be payable to lenderA" (ev.lenderA == lenderA && ev.lenderA == expectedRecipient)
          assertMsg "Payment evidence operator mismatch" (ev.operator == expectedOperator)
          assertMsg "Payment evidence instrument mismatch" (ev.instrument == instrument)

        fundedCashes <- mapA fetch fundedCashCids
        forA_ fundedCashes $ \c -> do
          assertMsg "Funded cash must be owned by lenderA" (c.owner == lenderA && c.owner == expectedRecipient)
          assertMsg "Funded cash operator mismatch" (c.operator == expectedOperator)
          assertMsg "Funded cash instrument mismatch" (c.instrument == instrument)
          assertMsg "Funded cash amount must be positive" (c.amount > 0.0)

        let evidenceTotal = sum (map (\e -> e.amount) evidences)
        let fundedTotal = sum (map (\c -> c.amount) fundedCashes)
        let totalPaid = evidenceTotal + fundedTotal
        assertMsg "Payment amount insufficient to satisfy payoff" (totalPaid >= payoffAmount)

        -- Consume each payment evidence once (archive it via ConsumeEvidence)
        forA_ paymentEvidenceCids (\cid -> exercise cid ConsumeEvidence)

        loanA <- fetch loanACid
        assertMsg "Payoff amount must match loan principal" (payoffAmount == loanA.principal)
        assertMsg "Collateral contract must match loan" (collateralCid == loanA.collateralCid)
        archive loanACid
        exercise collateralCid Repledge with
          newLocker  = newLocker
          newContext = "repledge-pending"


-- ─────────────────────────────────────────────────────────────────────────────
-- REPLACEMENT OFFER
-- LenderB's binding commitment to fund 100,000 and create LoanB.
-- Pins: exact new terms, exact collateral units, exact funding, exact expiry.
-- Privacy: visible to lenderB + borrower ONLY. LenderA is structurally excluded.
-- ─────────────────────────────────────────────────────────────────────────────

template ReplacementOffer
  with
    lenderB             : Party
    borrower            : Party
    operator            : Party
    expectedRecipient   : Party              -- pins recipient (must be lenderA)
    newPrincipal        : Decimal            -- 100,000.0
    maturityDate        : Date               -- new loan maturity
    collateralInstrument: Text               -- "COLLAT-TEST"
    collateralUnits     : Decimal            -- 150.0
    lenderBCashCid      : ContractId CashHolding  -- B's cash ready to deploy
    cashInstrument      : Text               -- "USD-TEST"
    expiresAt           : Time
    capRate             : Decimal            -- e.g. 0.075
    amortizationPeriods : Int                -- e.g. 24
  where
    signatory lenderB
    observer  borrower

    ensure newPrincipal > 0.0 && capRate > 0.0 && capRate < 1.0 && amortizationPeriods > 0 && collateralUnits > 0.0

    -- LenderB withdraws the offer before closing executes.
    choice WithdrawOffer : ()
      controller lenderB
      do return ()

    -- Disburse funding directly to expectedRecipient (Lender A).
    -- Strict sub-transaction privacy: this choice transfers cash to expectedRecipient ONLY.
    -- Payoff operations (PayoffQuote, SettleAndRepledge) are NOT nested under this choice,
    -- ensuring Lender B never witnesses PayoffQuote or payoff operations in full transaction trees.
    nonconsuming choice DisburseFunds : ContractId CashHolding
      controller borrower
      do
        now <- getTime
        assertMsg "ReplacementOffer has expired" (now < expiresAt)
        cash <- fetch lenderBCashCid
        assertMsg "Cash operator mismatch" (cash.operator == operator)
        assertMsg "Cash instrument mismatch" (cash.instrument == cashInstrument)
        assertMsg "Cash balance insufficient" (cash.amount >= newPrincipal)
        assertMsg "Payer must own the cash" (cash.owner == lenderB)

        (transferredCashCid, _change) <- if cash.amount == newPrincipal
          then do
            c <- exercise lenderBCashCid Transfer with recipient = expectedRecipient
            return (c, None)
          else do
            (c, ch) <- exercise lenderBCashCid TransferPartial with
              recipient      = expectedRecipient
              transferAmount = newPrincipal
            return (c, Some ch)

        return transferredCashCid

    -- Secure the repledged collateral and create Loan B.
    -- Executed after SettleAndRepledge, ensuring sub-transaction privacy tree separation.
    choice SecureLoan : ContractId LoanB
      with
        repledgedCollatCid : ContractId LockedCollateralHolding
      controller borrower
      do
        now <- getTime
        assertMsg "ReplacementOffer has expired" (now < expiresAt)

        repledgedCollat <- fetch repledgedCollatCid
        assertMsg "Collateral amount must match offer" (repledgedCollat.amount == collateralUnits)
        assertMsg "Collateral instrument mismatch" (repledgedCollat.instrument == collateralInstrument)
        assertMsg "Collateral locker must be lenderB" (repledgedCollat.locker == lenderB)

        boundCollatCid <- exercise repledgedCollatCid BindToLoan with
          loanContext = "LoanB-collateral"

        create LoanB with
          borrower
          lenderB
          operator
          principal = newPrincipal
          maturityDate
          collateralCid = boundCollatCid
          capRate
          amortizationPeriods

    -- Legacy DisburseAndSecure choice for backward compatibility
    choice DisburseAndSecure : (ContractId PaymentEvidence, ContractId LoanB)
      with
        payoffQuoteCid       : ContractId PayoffQuote
        borrowerEvidenceCid  : ContractId PaymentEvidence
        currentCollateralCid : ContractId LockedCollateralHolding
      controller borrower
      do
        disbursedCashCid <- exercise self DisburseFunds

        repledgedCollatCid <- exercise payoffQuoteCid SettleAndRepledge with
          newLocker           = lenderB
          collateralCid       = currentCollateralCid
          paymentEvidenceCids = [borrowerEvidenceCid]
          fundedCashCids      = [disbursedCashCid]

        loanB <- exercise self SecureLoan with repledgedCollatCid
        return (borrowerEvidenceCid, loanB)
