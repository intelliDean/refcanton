-- Approvals.daml
-- Ref Canton: Private Refinancing App
-- PayoffQuote (lenderA's binding release offer) and
-- ReplacementOffer (lenderB's binding funding commitment).
-- Pre-signed authorization contracts that make the atomic close possible.
-- Satisfies: "Binding approvals bind exact parties, loan state, amounts, asset identifiers, recipients, replacement terms and expiry." (spec line 15-16)

module Approvals where

import DA.Foldable (forA_)
import DA.List (dedup)
import Assets
import Loan

-- ─────────────────────────────────────────────────────────────────────────────
-- PAYMENT EVIDENCE
-- Single-use, loan-bound payment evidence produced during debt payoff.
-- Guarantees that payment proof cannot be reused across fresh loans or settlements,
-- while the recipient lender retains genuine spendable CashHolding.
-- ─────────────────────────────────────────────────────────────────────────────

template PaymentEvidence
  with
    loanACid   : ContractId LoanA   -- strictly bound to the target LoanA contract
    lenderA    : Party              -- recipient of payment
    payer      : Party              -- borrower or funding lender
    borrower   : Party              -- authorized borrower to consume evidence
    operator   : Party
    instrument : Text               -- "USD-TEST"
    amount     : Decimal            -- amount paid towards payoff
    settledAt  : Time
  where
    signatory payer
    observer  lenderA, borrower

    choice ConsumeEvidence : ()
      controller borrower
      do return ()


-- ─────────────────────────────────────────────────────────────────────────────
-- PAYOFF QUOTE
-- LenderA's binding offer to release LoanA and repledge collateral upon receiving 101,000.
-- Pins: exact loan state, exact amount, exact account, exact expiry.
-- Privacy: visible to lenderA + borrower ONLY. LenderB is structurally excluded.
-- ─────────────────────────────────────────────────────────────────────────────

template PayoffQuote
  with
    lenderA          : Party
    borrower         : Party
    expectedOperator : Party               -- pins asset operator/issuer
    expectedRecipient: Party               -- pins recipient (must be lenderA)
    expectedLocker   : Party               -- pins new locker (must be lenderB)
    loanACid         : ContractId LoanA   -- pins exact loan state (replay protection)
    payoffAmount     : Decimal            -- 101,000.0
    instrument       : Text               -- "USD-TEST"
    expiresAt        : Time               -- hard expiry
  where
    signatory lenderA
    observer  borrower

    ensure payoffAmount > 0.0 && expectedRecipient == lenderA

    -- LenderA revokes the quote prior to borrower triggering execution.
    choice WithdrawQuote : ()
      controller lenderA
      do return ()

    -- Borrower exercises this INSIDE ClosingRequest.Execute / DisburseAndSecure.
    -- Signatory lenderA + controller borrower provide authorization to archive LoanA
    -- and re-pledge the collateral to lenderB upon verified payment.
    choice SettleAndRepledge : ContractId LockedCollateralHolding
      with
        newLocker           : Party
        collateralCid       : ContractId LockedCollateralHolding
        paymentEvidenceCids : [ContractId PaymentEvidence]
      controller borrower
      do
        now <- getTime
        assertMsg "PayoffQuote has expired" (now < expiresAt)
        assertMsg "Payment evidence list cannot be empty" (not (null paymentEvidenceCids))
        assertMsg "Duplicate payment evidence IDs not allowed" (dedup paymentEvidenceCids == paymentEvidenceCids)
        assertMsg "Locker mismatch" (newLocker == expectedLocker)

        evidences <- mapA fetch paymentEvidenceCids
        forA_ evidences $ \ev -> do
          assertMsg "Payment evidence must be bound to this loan" (ev.loanACid == loanACid)
          assertMsg "Payment evidence must be payable to lenderA" (ev.lenderA == lenderA && ev.lenderA == expectedRecipient)
          assertMsg "Payment evidence operator mismatch" (ev.operator == expectedOperator)
          assertMsg "Payment evidence instrument mismatch" (ev.instrument == instrument)

        let totalPaid = sum (map (\e -> e.amount) evidences)
        assertMsg "Payment amount insufficient to satisfy payoff" (totalPaid >= payoffAmount)

        -- Consume each payment evidence once (archive it via ConsumeEvidence)
        forA_ paymentEvidenceCids (\cid -> exercise cid ConsumeEvidence)

        loanA <- fetch loanACid
        assertMsg "Payoff amount must match loan principal" (payoffAmount == loanA.principal)
        assertMsg "Collateral contract must match loan" (collateralCid == loanA.collateralCid)
        archive loanACid
        exercise collateralCid Repledge with
          newLocker  = newLocker
          newContext = "LoanB-collateral-pending"


-- ─────────────────────────────────────────────────────────────────────────────
-- REPLACEMENT OFFER
-- LenderB's binding commitment to fund 100,000 and create LoanB.
-- Pins: exact new terms, exact collateral units, exact funding, exact expiry.
-- Privacy: visible to lenderB + borrower ONLY. LenderA is structurally excluded.
-- ─────────────────────────────────────────────────────────────────────────────

template ReplacementOffer
  with
    lenderB             : Party
    borrower            : Party
    operator            : Party
    expectedRecipient   : Party              -- pins recipient (must be lenderA)
    newPrincipal        : Decimal            -- 100,000.0
    maturityDate        : Date               -- new loan maturity
    collateralInstrument: Text               -- "COLLAT-TEST"
    collateralUnits     : Decimal            -- 150.0
    lenderBCashCid      : ContractId CashHolding  -- B's cash ready to deploy
    cashInstrument      : Text               -- "USD-TEST"
    expiresAt           : Time
    capRate             : Decimal            -- e.g. 0.075
    amortizationPeriods : Int                -- e.g. 24
  where
    signatory lenderB
    observer  borrower

    ensure newPrincipal > 0.0 && capRate > 0.0 && capRate < 1.0 && amortizationPeriods > 0 && collateralUnits > 0.0

    -- LenderB withdraws the offer before closing executes.
    choice WithdrawOffer : ()
      controller lenderB
      do return ()

    -- Borrower exercises this INSIDE ClosingRequest.Execute.
    -- Signatory lenderB + controller borrower authorize transferring agreed principal
    -- to expectedRecipient ONLY while simultaneously securing and binding the repledged collateral.
    -- Eliminates independent disbursement without collateral securing.
    choice DisburseAndSecure : (ContractId PaymentEvidence, ContractId LoanB)
      with
        payoffQuoteCid       : ContractId PayoffQuote
        borrowerEvidenceCid  : ContractId PaymentEvidence
        currentCollateralCid : ContractId LockedCollateralHolding
      controller borrower
      do
        now <- getTime
        assertMsg "ReplacementOffer has expired" (now < expiresAt)

        bCash <- fetch lenderBCashCid
        assertMsg "Lender B cash insufficient" (bCash.amount >= newPrincipal)
        assertMsg "Cash instrument mismatch" (bCash.instrument == cashInstrument)
        assertMsg "Cash operator mismatch" (bCash.operator == operator)

        quote <- fetch payoffQuoteCid
        assertMsg "Quote recipient must match offer recipient" (quote.expectedRecipient == expectedRecipient)

        -- 1. Transfer Lender B's funding to expected recipient (Lender A)
        _cashForA <- if bCash.amount == newPrincipal
          then exercise lenderBCashCid Transfer with
            recipient = expectedRecipient
          else do
            (transferred, _change) <- exercise lenderBCashCid TransferPartial with
              recipient      = expectedRecipient
              transferAmount = newPrincipal
            return transferred

        -- 2. Issue PaymentEvidence from Lender B to Lender A bound to quote.loanACid
        lenderBEvidenceCid <- create PaymentEvidence with
          loanACid   = quote.loanACid
          lenderA    = expectedRecipient
          payer      = lenderB
          borrower   = borrower
          operator
          instrument = cashInstrument
          amount     = newPrincipal
          settledAt  = now

        -- 3. Settle PayoffQuote and re-pledge collateral to Lender B
        repledgedCollatCid <- exercise payoffQuoteCid SettleAndRepledge with
          newLocker           = lenderB
          collateralCid       = currentCollateralCid
          paymentEvidenceCids = [borrowerEvidenceCid, lenderBEvidenceCid]

        repledgedCollat <- fetch repledgedCollatCid
        assertMsg "Collateral amount must match offer" (repledgedCollat.amount == collateralUnits)
        assertMsg "Collateral instrument mismatch" (repledgedCollat.instrument == collateralInstrument)

        -- 4. Exclusively bind collateral to Loan B (produces non-rebindable BoundCollateralHolding)
        boundCollatCid <- exercise repledgedCollatCid BindToLoan with
          loanContext = "LoanB-collateral"

        -- 5. Create Loan B
        loanB <- create LoanB with
          borrower
          lenderB
          operator
          principal = newPrincipal
          maturityDate
          collateralCid = boundCollatCid
          capRate
          amortizationPeriods

        return (lenderBEvidenceCid, loanB)
